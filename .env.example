# Variables d'environnement — copier vers .env.local

# Préparation du formulaire de contact
# Service tiers (Formspree, Web3Forms, Resend, etc.)
# La destination réelle de l'e-mail se configure UNIQUEMENT dans le tableau
# de bord du prestataire — jamais dans le code affiché du site.
# Destination à renseigner chez le prestataire : jodiemanent@gmail.com
NEXT_PUBLIC_CONTACT_ENDPOINT=[À CONFIGURER]
NEXT_PUBLIC_CONTACT_ACCESS_KEY=

# Préparation Supabase (non branché)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
